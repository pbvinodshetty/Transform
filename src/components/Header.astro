---
import Icon from './Icon.astro';
import { site, nav, waLink } from '../data/site';

const bookText = 'Hello, I would like to book a consultation with Dr. Deepa.';
---

<header class="site-header" data-header>
  <div class="bar">
    <a href="#top" class="brand" aria-label="Transform Life Programs, back to top">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="brand-name">Transform Life</span>
    </a>

    <nav class="inline-nav" aria-label="Primary" data-nav>
      <ul role="list" data-nav-list>
        {nav.map((l) => <li><a href={l.href} data-spy={l.href}>{l.label}</a></li>)}
      </ul>
      <span class="indicator" aria-hidden="true" data-indicator></span>
    </nav>

    <div class="bar-end">
      <a href={`tel:${site.phones.appointments.tel}`} class="call-link" aria-label={`Call ${site.phones.appointments.display}`}>
        <span class="call-ic"><Icon name="phone" size={15} /></span>
        <span class="call-num">{site.phones.appointments.display}</span>
      </a>
      <a href={waLink(site.whatsapp.appointments, bookText)} class="btn btn-ink book-btn" target="_blank" rel="noopener">
        Book now <Icon name="arrow-up-right" size={14} />
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span class="visually-hidden" data-menu-label>Menu</span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <span class="progress" aria-hidden="true"></span>

  <div class="menu-panel" id="site-menu" data-mobile-nav hidden>
    <ul role="list" class="menu-links">
      {
        nav.map((l, i) => (
          <li style={`--mi:${i}`}>
            <a href={l.href} data-close-menu>
              {l.label}
              <Icon name="arrow-up-right" size={16} />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu-contact">
      <a href={`tel:${site.phones.appointments.tel}`}><span>Appointments</span>{site.phones.appointments.display}</a>
      <a href={`tel:${site.phones.crystals.tel}`}><span>Crystals & classes</span>{site.phones.crystals.display}</a>
    </div>
    <a href={waLink(site.whatsapp.appointments, bookText)} class="btn btn-ink menu-book" target="_blank" rel="noopener" data-close-menu>
      <Icon name="whatsapp" /> Book on WhatsApp
    </a>
  </div>
</header>

<script>
  // The active link follows the section in the middle of the screen, and a
  // white pill slides behind whichever link is active or hovered. Positions
  // are measured from the links' boxes and re-measured whenever the nav
  // changes size (fonts loading, resizing).
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const list = document.querySelector<HTMLElement>('[data-nav-list]');
  const indicator = document.querySelector<HTMLElement>('[data-indicator]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy]'));
  let active: HTMLAnchorElement | undefined = links[0];

  const moveTo = (a?: HTMLAnchorElement) => {
    if (!nav || !indicator || !a) return;
    const box = nav.getBoundingClientRect();
    const r = a.getBoundingClientRect();
    if (!r.width) return; // nav hidden on small screens
    indicator.style.width = `${r.width}px`;
    indicator.style.transform = `translateX(${r.left - box.left}px)`;
    indicator.classList.add('on');
  };

  const setActive = (a?: HTMLAnchorElement) => {
    active = a;
    links.forEach((l) => l.classList.toggle('active', l === a));
    moveTo(a);
  };

  links.forEach((a) => {
    a.addEventListener('mouseenter', () => moveTo(a));
    a.addEventListener('focus', () => moveTo(a));
  });
  list?.addEventListener('mouseleave', () => moveTo(active));
  if (nav && 'ResizeObserver' in window) new ResizeObserver(() => moveTo(active)).observe(nav);
  document.fonts?.ready.then(() => moveTo(active));

  const sections = links.map((a) => document.querySelector<HTMLElement>(a.dataset.spy!)).filter(Boolean) as HTMLElement[];
  if ('IntersectionObserver' in window && sections.length) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) setActive(links.find((a) => a.dataset.spy === `#${e.target.id}`));
        }),
      { rootMargin: '-50% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
  setActive(active);

  // Reading progress along the header's bottom edge.
  const header = document.querySelector<HTMLElement>('[data-header]');
  let ticking = false;
  const progress = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    header?.style.setProperty('--sp', max > 0 ? (window.scrollY / max).toFixed(4) : '0');
    ticking = false;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(progress);
    },
    { passive: true },
  );
  progress();
</script>

<style>
  /* Full-width bar. Its frosted background lives on ::before so it can
     change on scroll without affecting the content, and so it also covers
     the mobile menu when that opens beneath the bar. */
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    color: var(--ink);
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-bottom: 1px solid transparent;
    background: rgba(244, 244, 242, 0.72);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    transition: background-color 0.4s, border-color 0.4s, box-shadow 0.4s;
  }

  .site-header:global(.is-scrolled)::before,
  .site-header:global(.menu-open)::before {
    border-bottom-color: var(--card-line);
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 12px 32px -22px rgba(24, 24, 29, 0.3);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    width: min(100% - 2 * var(--gutter), 1200px);
    height: 68px;
    margin-inline: auto;
    transition: height 0.4s var(--ease);
  }

  .site-header:global(.is-scrolled) .bar {
    height: 60px;
  }

  @media (min-width: 1024px) {
    .bar {
      grid-template-columns: 1fr auto 1fr;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar {
      animation: bar-in 0.9s var(--ease-out) 0.1s both;
    }
  }

  @keyframes bar-in {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    color: inherit;
    text-decoration: none;
  }

  /* Four-petal mark, echoing a flower of life */
  .brand-mark {
    position: relative;
    width: 22px;
    height: 22px;
    transition: rotate 0.8s var(--ease);
  }

  .brand:hover .brand-mark {
    rotate: 90deg;
  }

  .brand-mark i {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50% 50% 50% 0;
    background: var(--blue);
  }

  .brand-mark i:nth-child(1) {
    top: 0;
    left: 6px;
    rotate: 135deg;
  }

  .brand-mark i:nth-child(2) {
    top: 6px;
    right: 0;
    rotate: 225deg;
    background: var(--periwinkle-500);
  }

  .brand-mark i:nth-child(3) {
    bottom: 0;
    left: 6px;
    rotate: 315deg;
  }

  .brand-mark i:nth-child(4) {
    top: 6px;
    left: 0;
    rotate: 45deg;
    background: var(--periwinkle-500);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Segmented control: a soft track with a white pill under the active link */
  .inline-nav {
    position: relative;
    display: none;
    padding: 4px;
    border-radius: 14px;
    background: rgba(24, 24, 29, 0.045);
    box-shadow: inset 0 0 0 1px var(--card-line);
  }

  @media (min-width: 1024px) {
    .inline-nav {
      display: block;
    }
  }

  .inline-nav ul {
    position: relative;
    z-index: 1;
    display: flex;
    margin: 0;
    padding: 0;
  }

  .inline-nav a {
    display: block;
    padding: 0.45rem 0.95rem;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-3);
    text-decoration: none;
    transition: color 0.3s;
  }

  .inline-nav a:hover,
  .inline-nav a:global(.active) {
    color: var(--ink);
  }

  .indicator {
    position: absolute;
    top: 4px;
    left: 0;
    height: calc(100% - 8px);
    border-radius: 10px;
    background: var(--white);
    box-shadow:
      0 1px 2px rgba(24, 24, 29, 0.08),
      0 6px 14px -6px rgba(24, 24, 29, 0.18);
    opacity: 0;
    transition: transform 0.5s var(--ease), width 0.5s var(--ease), opacity 0.3s;
  }

  .indicator:global(.on) {
    opacity: 1;
  }

  .bar-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: end;
  }

  .call-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.25rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.25s;
  }

  .call-link:hover {
    background: rgba(24, 24, 29, 0.05);
  }

  .call-ic {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--card-line);
    color: var(--blue);
  }

  .call-num {
    display: none;
  }

  @media (min-width: 1200px) {
    .call-link {
      padding-right: 0.85rem;
    }

    .call-num {
      display: inline;
    }
  }

  .bar-end .btn {
    min-height: 40px;
    padding: 0.55rem 1.05rem;
    border-radius: 12px;
    font-size: 0.8125rem;
    box-shadow: 0 8px 16px -10px rgba(18, 18, 20, 0.7);
  }

  /* On the narrowest phones booking moves into the menu */
  .book-btn {
    display: none;
  }

  @media (min-width: 480px) {
    .book-btn {
      display: inline-flex;
    }
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 12px;
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--card-line);
    color: var(--ink);
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }
  }

  .bars {
    display: grid;
    gap: 4px;
    width: 15px;
  }

  .bars i {
    display: block;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.35s var(--ease);
  }

  .menu-toggle[aria-expanded='true'] .bars i:first-child {
    transform: translateY(2.75px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .bars i:last-child {
    transform: translateY(-2.75px) rotate(-45deg);
  }

  /* Reading progress */
  .progress {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--periwinkle-500), var(--blue));
    opacity: 0;
    transform: scaleX(var(--sp, 0));
    transform-origin: 0 50%;
    transition: opacity 0.3s;
  }

  .site-header:global(.is-scrolled) .progress {
    opacity: 1;
  }

  /* Mobile menu: a full-width sheet beneath the bar */
  .menu-panel {
    width: min(100% - 2 * var(--gutter), 1200px);
    margin-inline: auto;
    padding: 0.25rem 0 1.25rem;
  }

  .menu-panel[hidden] {
    display: none;
  }

  .menu-links {
    margin: 0;
    padding: 0;
  }

  .menu-links li + li {
    border-top: 1px solid var(--card-line);
  }

  .menu-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 0.25rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }

  .menu-links a :global(svg) {
    color: var(--text-3);
    transition: transform 0.35s var(--ease), color 0.25s;
  }

  .menu-links a:hover :global(svg) {
    color: var(--blue);
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-panel:not([hidden]) li {
      animation: m-in 0.5s var(--ease-out) both;
      animation-delay: calc(var(--mi) * 45ms + 40ms);
    }
  }

  @keyframes m-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .menu-contact {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .menu-contact a {
    display: grid;
    gap: 0.1rem;
    padding: 0.8rem 0.9rem;
    border-radius: 14px;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--card-line);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .menu-contact span {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .menu-book {
    width: 100%;
    margin-top: 0.75rem;
  }
</style>
