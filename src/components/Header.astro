---
import Icon from './Icon.astro';
import { site, nav, waLink } from '../data/site';

const bookText = 'Hello, I would like to book a consultation with Dr. Deepa.';
---

<header class="site-header" data-header>
  <div class="bar">
    <div class="island nav-island">
      <a href="#top" class="brand" aria-label="Transform Life Programs, back to top">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="brand-name">Transform Life</span>
      </a>

      <nav class="inline-nav" aria-label="Primary">
        <span class="indicator" aria-hidden="true" data-indicator></span>
        <ul role="list" data-nav-list>
          {nav.map((l) => <li><a href={l.href} data-spy={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="island act-island">
      <a href={`tel:${site.phones.appointments.tel}`} class="btn btn-soft call-btn">Call</a>
      <a href={waLink(site.whatsapp.appointments, bookText)} class="btn btn-ink book-btn" target="_blank" rel="noopener">
        Book now <Icon name="arrow-up-right" size={14} />
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span class="visually-hidden" data-menu-label>Menu</span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="island menu-panel" id="site-menu" data-mobile-nav hidden>
    <ul role="list">
      {nav.map((l, i) => <li style={`--mi:${i}`}><a href={l.href} data-close-menu>{l.label}</a></li>)}
    </ul>
    <div class="menu-contact">
      <a href={`tel:${site.phones.appointments.tel}`}><span>Appointments</span>{site.phones.appointments.display}</a>
      <a href={`tel:${site.phones.crystals.tel}`}><span>Crystals & classes</span>{site.phones.crystals.display}</a>
    </div>
    <a href={waLink(site.whatsapp.appointments, bookText)} class="btn btn-ink menu-book" target="_blank" rel="noopener" data-close-menu>
      <Icon name="whatsapp" /> Book on WhatsApp
    </a>
  </div>
</header>

<script>
  // The active link follows the section in the middle of the screen, and a
  // soft pill slides behind whichever link is active or hovered.
  const list = document.querySelector<HTMLElement>('[data-nav-list]');
  const indicator = document.querySelector<HTMLElement>('[data-indicator]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy]'));
  let active: HTMLAnchorElement | undefined = links[0];

  const moveTo = (a?: HTMLAnchorElement) => {
    if (!list || !indicator || !a) return;
    indicator.style.width = `${a.offsetWidth}px`;
    indicator.style.transform = `translateX(${a.offsetLeft}px)`;
    indicator.classList.add('on');
  };

  const setActive = (a?: HTMLAnchorElement) => {
    active = a;
    links.forEach((l) => l.classList.toggle('active', l === a));
    moveTo(a);
  };

  links.forEach((a) => {
    a.addEventListener('mouseenter', () => moveTo(a));
    a.addEventListener('focus', () => moveTo(a));
  });
  list?.addEventListener('mouseleave', () => moveTo(active));
  window.addEventListener('resize', () => moveTo(active));
  document.fonts?.ready.then(() => moveTo(active));

  const sections = links.map((a) => document.querySelector<HTMLElement>(a.dataset.spy!)).filter(Boolean) as HTMLElement[];
  if ('IntersectionObserver' in window && sections.length) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) setActive(links.find((a) => a.dataset.spy === `#${e.target.id}`));
        }),
      { rootMargin: '-50% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
  setActive(active);
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    padding: 14px var(--gutter) 0;
    pointer-events: none;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    max-width: 1200px;
    margin-inline: auto;
  }

  @media (min-width: 1024px) {
    .bar {
      justify-content: center;
    }
  }

  /* White rounded islands, as in the reference: one for the brand and
     links, one for the actions. */
  .island {
    display: flex;
    align-items: center;
    padding: 0.4rem;
    border: 1px solid var(--card-line);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: var(--card-shadow);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    color: var(--ink);
    pointer-events: auto;
    transition: background-color 0.4s, box-shadow 0.4s var(--ease);
  }

  .site-header:global(.is-scrolled) .island {
    background: rgba(255, 255, 255, 0.96);
    box-shadow:
      0 1px 2px rgba(24, 24, 29, 0.05),
      0 18px 40px -20px rgba(24, 24, 29, 0.3);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar {
      animation: bar-in 0.9s var(--ease-out) 0.1s both;
    }
  }

  @keyframes bar-in {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }
  }

  .nav-island {
    gap: 1.25rem;
    padding-left: 0.9rem;
  }

  .act-island {
    gap: 0.4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.4rem 0.35rem 0;
    text-decoration: none;
    color: inherit;
  }

  /* Four-petal mark, echoing a flower of life */
  .brand-mark {
    position: relative;
    width: 20px;
    height: 20px;
  }

  .brand-mark i {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50% 50% 50% 0;
    background: var(--blue);
  }

  .brand-mark i:nth-child(1) {
    top: 0;
    left: 5.5px;
    rotate: 135deg;
  }

  .brand-mark i:nth-child(2) {
    top: 5.5px;
    right: 0;
    rotate: 225deg;
    background: var(--periwinkle-500);
  }

  .brand-mark i:nth-child(3) {
    bottom: 0;
    left: 5.5px;
    rotate: 315deg;
  }

  .brand-mark i:nth-child(4) {
    top: 5.5px;
    left: 0;
    rotate: 45deg;
    background: var(--periwinkle-500);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .inline-nav {
    position: relative;
    display: none;
  }

  @media (min-width: 1024px) {
    .inline-nav {
      display: block;
    }
  }

  .inline-nav ul {
    display: flex;
    margin: 0;
    padding: 0;
  }

  .indicator {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    border-radius: 10px;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--card-line);
    opacity: 0;
    transition: transform 0.5s var(--ease), width 0.5s var(--ease), opacity 0.3s;
  }

  .indicator:global(.on) {
    opacity: 1;
  }

  .inline-nav a {
    position: relative;
    z-index: 1;
    display: block;
    padding: 0.5rem 0.85rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-3);
    text-decoration: none;
    transition: color 0.3s;
  }

  .inline-nav a:hover,
  .inline-nav a:global(.active) {
    color: var(--ink);
  }

  .act-island .btn {
    min-height: 38px;
    padding: 0.5rem 0.95rem;
    border-radius: 10px;
    font-size: 0.8125rem;
  }

  .act-island .btn-ink {
    box-shadow: 0 8px 16px -10px rgba(18, 18, 20, 0.7);
  }

  /* On the narrowest phones the bar holds just the brand and the menu
     button; booking moves into the menu. */
  .book-btn,
  .call-btn {
    display: none;
  }

  @media (min-width: 480px) {
    .book-btn {
      display: inline-flex;
    }
  }

  @media (min-width: 560px) {
    .call-btn {
      display: inline-flex;
    }
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--card-line);
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }
  }

  .bars {
    display: grid;
    gap: 4px;
    width: 14px;
  }

  .bars i {
    display: block;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.35s var(--ease);
  }

  .menu-toggle[aria-expanded='true'] .bars i:first-child {
    transform: translateY(2.75px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .bars i:last-child {
    transform: translateY(-2.75px) rotate(-45deg);
  }

  /* Mobile menu: the same white island, dropping from the bar */
  .menu-panel {
    display: block;
    width: min(340px, 100%);
    margin: 0.5rem 0 0 auto;
    padding: 0.6rem;
    border-radius: 20px;
    transform-origin: top right;
  }

  .menu-panel[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-panel {
      animation: panel-in 0.45s var(--ease-out);
    }

    .menu-panel:not([hidden]) li {
      animation: m-in 0.5s var(--ease-out) both;
      animation-delay: calc(var(--mi) * 40ms + 60ms);
    }
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.96);
    }
  }

  @keyframes m-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .menu-panel ul {
    margin: 0;
    padding: 0;
  }

  .menu-panel li a {
    display: block;
    padding: 0.65rem 0.9rem;
    border-radius: 12px;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: background-color 0.2s, padding 0.3s var(--ease);
  }

  .menu-panel li a:hover {
    background: var(--paper);
    padding-left: 1.2rem;
  }

  .menu-contact {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.5rem;
    padding: 0.9rem 0.9rem 0.5rem;
    border-top: 1px solid var(--card-line);
  }

  .menu-contact a {
    display: grid;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .menu-contact span {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-3);
  }

  .menu-book {
    width: 100%;
    margin-top: 0.6rem;
  }
</style>
