---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BlurTitle from '../components/BlurTitle.astro';
import { site, waLink } from '../data/site';
import { categories, programs, programsIn, programBySlug, type CategoryId } from '../data/programs';
import { founder, awards } from '../data/people';
import { img } from '../lib/images';

const catIds = Object.keys(categories) as CategoryId[];
const ecc = programBySlug('evolving-cosmic-communion')!;
const bookText = 'Hello, I would like to book a consultation with Dr. Deepa.';

// Figures, all taken from the site data.
const stats = [
  { n: programs.length, label: 'Programs', icon: 'layers' },
  { n: catIds.length, label: 'Themes', icon: 'sparkle' },
  { n: awards.length, label: 'Awards & honours', icon: 'award' },
] as const;

// Dr. Deepa's path to this work, condensed from her story in src/data/people.ts.
const journey = [
  { title: 'Teacher & counsellor', text: 'Almost two decades teaching English.' },
  { title: 'A turning point', text: 'Recovered with Reiki after five surgeries.' },
  { title: 'Heal Your Life® leader', text: 'Certified to lead Louise L. Hay’s workshop.' },
  { title: 'Founder & channeler', text: 'Founded the centre with her daughter, Rekha Datta.' },
];
const topAward = awards[0];

// The three ways in. Counselling leads the bento as the usual starting point;
// each card opens WhatsApp with a message about that service.
const offers = [
  {
    image: 'gallery/session-03',
    tag: 'Counselling',
    title: 'One-to-one counselling',
    text: 'Sit down with Dr. Deepa, talk through what you’re facing and find your starting point.',
    cta: 'Book a session',
    ask: 'Hello, I would like to book a one-to-one counselling session with Dr. Deepa.',
  },
  {
    image: 'stock/candle-hands',
    tag: 'Energy healing',
    title: 'Channelled energy work',
    text: 'Modalities channelled by Dr. Deepa, including Evolving Cosmic Communion.',
    cta: 'Ask about energy work',
    ask: 'Hello, I would like to know more about channelled energy work.',
  },
  {
    image: 'stock/herbs',
    tag: 'Natural healing',
    title: 'Body & natural healing',
    text: categories.body.blurb,
    cta: 'Ask about natural healing',
    ask: 'Hello, I would like to know more about body & natural healing.',
  },
];

const themeImages: Record<CategoryId, string> = {
  signature: 'stock/milky-way',
  body: 'stock/herbs',
  self: 'gallery/session-01',
  soul: 'stock/nature',
};


// Hero headline; the middle word is set in the softer grey.
const heroWords = [{ t: 'Find' }, { t: 'your', soft: true }, { t: 'calm' }];

// Hero tiles: every program as a small cover, in two strips that drift past
// behind the phone. Several programs share a photo, so some get a stock image.
const tileArt: Partial<Record<string, string>> = {
  'evolving-cosmic-communion': 'stock/milky-way',
  'natural-healing-secrets': 'stock/herbs',
  'holistic-to-soulistic': 'stock/nature',
  'angelic-consciousness': 'stock/candle-hands',
  merkaba: 'gallery/session-07',
};
const tiles = programs.map((p) => ({ label: p.name, image: tileArt[p.slug] ?? p.image }));
// Each strip holds every program, the second starting halfway through. The set
// is repeated three times so the loop stays seamless on very wide screens.
const tileRows = [0, 7].map((start) => tiles.map((_, k) => tiles[(start + k) % tiles.length]));
const tileLoop = [0, 1, 2];

// The phone shows how booking works: a short chat on WhatsApp that plays out
// message by message and ends with the confirmed appointment.
const hours = site.hours[0];
const chat = [
  { me: true, text: 'Hello, I would like to book a consultation with Dr. Deepa.', time: '10:24' },
  { me: false, text: `Namaste! We see clients ${hours.days}, ${hours.time}. Which day suits you?`, time: '10:26' },
  { me: true, text: 'Thursday morning, please.', time: '10:27' },
];
const booking = { when: 'Thursday · 11:00 am', where: `Dr. Deepa · ${site.address.locality}`, time: '10:28' };
---

<Base title={site.name}>
  <!-- ============ HERO: headline, chat phone between program tiles, call to action ============ -->
  <section class="hero" id="top" data-hero>
    <div class="wrap">
      <h1 class="hero-title">
        {
          heroWords.map((w, i) => (
            <>
              <span class:list={['ht', { soft: w.soft }]} style={`--li:${i}`}>{w.t}</span>{' '}
            </>
          ))
        }
      </h1>
    </div>

    <div class="hero-stage" aria-hidden="true" data-hero-stage>
      <div class="tiles">
        {
          tileRows.map((row) => (
            <div class="tile-row">
              <div class="tile-track">
                {tileLoop.map(() =>
                  row.map((t) => (
                    <div class="tile">
                      <Image src={img(t.image)} alt="" widths={[140, 260]} sizes="128px" />
                      <span>{t.label}</span>
                    </div>
                  )),
                )}
              </div>
            </div>
          ))
        }
      </div>

      <div class="phone-tilt" data-tilt>
        <div class="phone">
          <div class="screen">
            <div class="status">
              <span>10:30</span>
              <span class="island-cut"></span>
              <span class="signal"><i></i><i></i><i></i></span>
            </div>
            <div class="chat-head">
              <Icon name="chevron" size={14} class="back" />
              <span class="avatar">TL</span>
              <span class="who"><strong>Transform Life</strong><small data-chat-status>Appointments · online</small></span>
              <Icon name="phone" size={14} />
            </div>
            <div class="chat" data-chat>
              {
                chat.map((m) => (
                  <p class:list={['msg', m.me ? 'msg-out' : 'msg-in']} data-msg>
                    {m.text}
                    <small>
                      {m.time}
                      {m.me && <Icon name="check" size={10} />}
                    </small>
                  </p>
                ))
              }
              <div class="msg msg-in booked" data-msg>
                <span class="booked-head"><Icon name="check" size={12} /> Appointment confirmed</span>
                <strong>{booking.when}</strong>
                <span>{booking.where}</span>
                <small>{booking.time}</small>
              </div>
              <p class="msg msg-in typing" data-typing><i></i><i></i><i></i></p>
            </div>
            <div class="composer">
              <span>Message</span>
              <span class="send"><Icon name="arrow" size={12} /></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="wrap hero-copy">
      <p class="hero-lede">
        <strong>{site.name}</strong> is a healing and counselling centre in Bengaluru, led by {site.founder}. Counselling, energy healing and {programs.length} programs, at a pace that feels right for you.
      </p>
      <a href={waLink(site.whatsapp.appointments, bookText)} class="btn btn-ink hero-btn" target="_blank" rel="noopener"><Icon name="whatsapp" /> Book on WhatsApp</a>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="sec about" id="about">
    <div class="wrap center-head">
      <p class="eyebrow" data-animate>About us</p>
      <BlurTitle text="Meet Dr. Deepa, *a guide back to yourself.*" />
      <p class="lede" data-animate>A counsellor and energy healer who taught English for almost two decades before healing became her life’s work.</p>
    </div>

    <div class="wrap">
      <div class="card founder" data-animate="scale">
        <div class="founder-media">
          <figure class="founder-photo">
            <Image src={img('founder/portrait-lilac')} alt={founder.name} widths={[480, 720, 900]} sizes="(min-width: 860px) 40vw, 90vw" />
          </figure>
          <p class="badge badge-tag float"><Icon name="sparkle" size={14} /> Reiki Master</p>
          <p class="badge badge-award float-slow">
            <span class="badge-ic"><Icon name="award" size={18} /></span>
            <span>
              <strong>{topAward.title}</strong>
              <small>{[topAward.issuer, topAward.year].filter(Boolean).join(' · ')}</small>
            </span>
          </p>
        </div>

        <div class="founder-story">
          <div class="founder-name">
            <h3 class="card-title">{founder.name}</h3>
            <p>{founder.credentials} · Honorary Doctorate (Holistic Healing)</p>
          </div>
          <ul role="list" class="chips">
            {founder.roles.map((r) => <li>{r}</li>)}
          </ul>
          <ol role="list" class="journey">
            {
              journey.map((j) => (
                <li>
                  <strong>{j.title}</strong>
                  <span>{j.text}</span>
                </li>
              ))
            }
          </ol>
          <div class="founder-cta">
            <a href={waLink(site.whatsapp.appointments, bookText)} class="btn btn-ink" target="_blank" rel="noopener">Book a consultation <Icon name="arrow-up-right" size={14} /></a>
            <a href={`tel:${site.phones.appointments.tel}`} class="founder-call">or call {site.phones.appointments.display}</a>
          </div>
        </div>

        <dl class="founder-stats">
          {
            stats.map((s) => (
              <div>
                <dt>
                  <span class="stat-ic" aria-hidden="true"><Icon name={s.icon} size={16} /></span>
                  {s.label}
                </dt>
                <dd data-count-to={s.n}>{s.n}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ APPROACH ============ -->
  <section class="sec approach" id="approach">
    <div class="wrap center-head">
      <p class="eyebrow" data-animate>Our approach</p>
      <BlurTitle text="Heal your body, mind *and spirit in one place.*" />
      <p class="lede" data-animate>Counselling, energy healing and practical tools come together at our centre in Bengaluru. Start with a consultation and Dr. Deepa will help you choose the right path.</p>
    </div>
    <div class="wrap offer-grid" data-stagger>
      {
        offers.map((o, i) => (
          <article class:list={['offer', { 'offer-lead': i === 0 }]}>
            <Image
              src={img(o.image)}
              alt=""
              widths={[640, 960, 1280, 1600]}
              sizes={i === 0 ? '(min-width: 860px) 62vw, 100vw' : '(min-width: 860px) 46vw, 100vw'}
              quality={88}
            />
            <span class="offer-tag">
              <span class="offer-n">{String(i + 1).padStart(2, '0')}</span>
              {o.tag}
            </span>
            <div class="offer-body">
              <div>
                <h3 class="card-title">{o.title}</h3>
                <p>{o.text}</p>
              </div>
              <span class="offer-go" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
            </div>
            <a href={waLink(site.whatsapp.appointments, o.ask)} class="offer-link" target="_blank" rel="noopener">
              <span class="visually-hidden">{o.cta}</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============ SIGNATURE: Evolving Cosmic Communion in a night-sky panel ============ -->
  <section class="sec signature" id="signature">
    <div class="wrap center-head">
      <p class="eyebrow" data-animate>Signature modality</p>
      <BlurTitle text="Evolving Cosmic *Communion*" />
      <p class="lede" data-animate>{ecc.short}</p>
    </div>

    <div class="wrap">
      <div class="cosmos" data-cosmos data-animate>
        <canvas class="cosmos-canvas" data-sphere aria-hidden="true"></canvas>

        <div class="ecc-stage">
          <div class="orb-slot" data-orb></div>
          {
            [ecc.explore.slice(0, 2), ecc.explore.slice(2, 4)].map((col, c) => (
              <div class={`ecc-col ecc-col-${c}`}>
                {col.map((e, k) => (
                  <div class="ecc-card" data-animate={c === 0 ? 'left' : 'right'}>
                    <span class="ecc-n">{String(c * 2 + k + 1).padStart(2, '0')}</span>
                    <h3>{e.title}</h3>
                    <p>{e.text}</p>
                  </div>
                ))}
              </div>
            ))
          }
        </div>

        {ecc.quote && <blockquote class="ecc-quote" data-animate>“{ecc.quote.replace(' — ', ' — ')}”</blockquote>}

        <div class="ecc-flow" data-animate>
          <div>
            <p class="flow-label">How a session flows</p>
            <ol role="list" class="flow-steps">
              {
                (ecc.process ?? []).map((s, i) => (
                  <li>
                    <span class="flow-n">{String(i + 1).padStart(2, '0')}</span>
                    <strong>{s.title}</strong>
                    <span class="flow-txt">{s.text}</span>
                  </li>
                ))
              }
            </ol>
          </div>
          <a href={waLink(site.whatsapp.appointments, `Hello, I would like to know more about ${ecc.name}.`)} class="btn btn-light" target="_blank" rel="noopener">Ask about ECC <Icon name="arrow-up-right" size={14} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROGRAMS ============ -->
  <section class="sec programs" id="programs">
    <div class="wrap center-head">
      <p class="eyebrow" data-animate>Programs</p>
      <BlurTitle text="Programs that *meet you where you are.*" />
      <p class="lede" data-animate>{programs.length} programs across four themes. Not sure where to start? Ask us — we’ll help you choose.</p>
    </div>

    <div class="wrap" data-tabs>
      <div class="tab-row" role="tablist" aria-label="Program themes" data-animate>
        {
          catIds.map((id, i) => (
            <button class={`tab-btn ${categories[id].tone}`} role="tab" id={`tab-${id}`} aria-controls={`theme-${id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab>
              <span class="tab-dot" aria-hidden="true"></span>
              {categories[id].name}
              <span class="tab-count">{programsIn(id).length}</span>
            </button>
          ))
        }
      </div>

      {
        catIds.map((id, i) => {
          const list = programsIn(id);
          return (
            <div class={`card panel ${categories[id].tone}`} role="tabpanel" id={`theme-${id}`} aria-labelledby={`tab-${id}`} data-panel data-active={i === 0 ? '' : undefined}>
              <div class="panel-feature">
                <div class="panel-img">
                  <Image src={img(themeImages[id])} alt="" widths={[560, 900]} sizes="(min-width: 960px) 40vw, 92vw" />
                </div>
                <div class="panel-info">
                  <span class="ct">{list.length} programs</span>
                  <h3 class="card-title">{categories[id].name}</h3>
                  <p>{categories[id].blurb}</p>
                </div>
              </div>
              <ol role="list" class="prog-list">
                {list.map((p, n) => (
                  <li>
                    <a href={waLink(site.whatsapp.appointments, `Hello, I would like to know more about ${p.name}.`)} class="prog-row" target="_blank" rel="noopener">
                      <span class="prog-n">{String(n + 1).padStart(2, '0')}</span>
                      <span class="prog-txt">
                        <strong>{p.name}</strong>
                        <span>{p.short}</span>
                      </span>
                      <span class="prog-go" aria-hidden="true"><Icon name="arrow-up-right" size={15} /></span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          );
        })
      }
    </div>
  </section>
</Base>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Program theme tabs (arrow keys move between them).
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(j === i));
        t.tabIndex = j === i ? 0 : -1;
      });
      panels.forEach((p, j) => p.toggleAttribute('data-active', j === i));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        select((i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length, true);
      });
    });
    const fromHash = panels.findIndex((p) => `#${p.id}` === window.location.hash);
    if (fromHash >= 0) select(fromHash);
  });

  // Hero: the tile strips pause while off screen, the phone leans toward the
  // pointer, and the chat plays out on a loop. With reduced motion the whole
  // conversation simply shows, still.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  if (stage && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => stage.classList.toggle('paused', !entry.isIntersecting)).observe(stage);
  }

  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  if (!reduced && hero && tilt && window.matchMedia('(pointer: fine)').matches) {
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      const nx = (e.clientX - r.left) / r.width - 0.5;
      const ny = (e.clientY - r.top) / r.height - 0.5;
      tilt.style.setProperty('--ry', `${(nx * 10).toFixed(2)}deg`);
      tilt.style.setProperty('--rx', `${(-ny * 6).toFixed(2)}deg`);
    });
    hero.addEventListener('pointerleave', () => {
      tilt.style.removeProperty('--rx');
      tilt.style.removeProperty('--ry');
    });
  }

  const chatBox = document.querySelector<HTMLElement>('[data-chat]');
  if (!reduced && chatBox) {
    const items = Array.from(chatBox.querySelectorAll<HTMLElement>('[data-msg]'));
    const typing = chatBox.querySelector<HTMLElement>('[data-typing]');
    const status = document.querySelector<HTMLElement>('[data-chat-status]');
    const online = status?.textContent ?? '';
    const wait = (ms: number) => new Promise((done) => setTimeout(done, ms));
    const setTyping = (on: boolean) => {
      typing?.classList.toggle('on', on);
      if (status) status.textContent = on ? 'typing…' : online;
    };

    chatBox.classList.add('is-live');
    (async () => {
      for (let first = true; ; first = false) {
        chatBox.classList.remove('fading');
        items.forEach((el) => el.classList.remove('shown'));
        await wait(first ? 1500 : 700);
        for (const el of items) {
          // Replies from the centre are preceded by a moment of typing.
          if (!el.classList.contains('msg-out')) {
            setTyping(true);
            await wait(1500);
            setTyping(false);
          }
          el.classList.add('shown');
          await wait(1300);
        }
        await wait(4500);
        chatBox.classList.add('fading');
        await wait(500);
      }
    })();
  }

  // The ECC night sky: twinkling stars and a sphere of glowing points with a
  // ringed orbit and a small moon. The canvas covers the whole panel; the
  // sphere sits over the empty [data-orb] cell. It runs only while on screen.
  const cosmos = document.querySelector<HTMLElement>('[data-cosmos]');
  const canvas = cosmos?.querySelector<HTMLCanvasElement>('[data-sphere]');
  const orb = cosmos?.querySelector<HTMLElement>('[data-orb]');
  const ctx = canvas?.getContext('2d');
  if (cosmos && canvas && orb && ctx) {
    const TAU = Math.PI * 2;

    // One soft, glowing dot, drawn once and stamped for every point.
    const sprite = document.createElement('canvas');
    sprite.width = sprite.height = 64;
    const sctx = sprite.getContext('2d')!;
    const dot = sctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    dot.addColorStop(0, 'rgba(255, 255, 255, 1)');
    dot.addColorStop(0.22, 'rgba(220, 224, 255, 0.9)');
    dot.addColorStop(0.55, 'rgba(140, 147, 227, 0.22)');
    dot.addColorStop(1, 'rgba(140, 147, 227, 0)');
    sctx.fillStyle = dot;
    sctx.fillRect(0, 0, 64, 64);

    // Points spread evenly over a sphere (Fibonacci lattice).
    const points: [number, number, number][] = [];
    const count = 900;
    for (let i = 0; i < count; i++) {
      const y = 1 - (i / (count - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      const a = i * 2.399963;
      points.push([Math.cos(a) * r, y, Math.sin(a) * r]);
    }
    const stars = Array.from({ length: 150 }, () => ({
      x: Math.random(),
      y: Math.random(),
      r: Math.random() * 1 + 0.3,
      phase: Math.random() * TAU,
      speed: 0.5 + Math.random() * 1.5,
    }));
    const dust = Array.from({ length: 80 }, () => ({
      a: Math.random() * TAU,
      r: 1.25 + Math.random() * 0.9,
      y: (Math.random() - 0.5) * 1.4,
      s: Math.random() * 0.8 + 0.4,
      v: Math.random() * 0.1 + 0.04,
    }));

    let w = 0;
    let h = 0;
    let cx = 0;
    let cy = 0;
    let R = 0;
    let t = 0;
    let rot = 0;
    let tilt = 0.35;
    let tiltTo = 0.35;
    let spin = 0.18;
    let spinTo = 0.18;

    const size = () => {
      const box = cosmos.getBoundingClientRect();
      const slot = orb.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = box.width;
      h = box.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx = slot.left - box.left + slot.width / 2;
      cy = slot.top - box.top + slot.height / 2;
      R = Math.min(slot.width, slot.height) * 0.34;
    };

    const stamp = (x: number, y: number, d: number, alpha: number) => {
      ctx.globalAlpha = alpha;
      ctx.drawImage(sprite, x - d / 2, y - d / 2, d, d);
    };

    // The orbit, drawn in two halves so it passes behind the sphere and
    // then in front of it. The moon rides the same ellipse.
    const ringRx = () => R * 1.6;
    const ringRy = () => R * 0.42;
    const ringTilt = -0.25;
    const onRing = (a: number) => {
      const x = Math.cos(a) * ringRx();
      const y = Math.sin(a) * ringRy();
      return [cx + x * Math.cos(ringTilt) - y * Math.sin(ringTilt), cy + x * Math.sin(ringTilt) + y * Math.cos(ringTilt)];
    };
    const ring = (from: number, to: number, alpha: number) => {
      const g = ctx.createLinearGradient(cx - ringRx(), 0, cx + ringRx(), 0);
      g.addColorStop(0, 'rgba(180, 186, 234, 0)');
      g.addColorStop(0.5, `rgba(200, 205, 255, ${alpha})`);
      g.addColorStop(1, 'rgba(180, 186, 234, 0)');
      ctx.globalAlpha = 1;
      ctx.strokeStyle = g;
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.ellipse(cx, cy, ringRx(), ringRy(), ringTilt, from, to);
      ctx.stroke();
    };
    const moon = (front: boolean) => {
      const a = t * 0.45;
      if (Math.sin(a) > 0 !== front) return;
      for (let k = 6; k >= 0; k--) {
        const [x, y] = onRing(a - k * 0.035);
        stamp(x, y, k ? 10 - k : 18, k ? 0.5 - k * 0.07 : 1);
      }
    };

    const draw = () => {
      ctx.globalCompositeOperation = 'source-over';
      ctx.clearRect(0, 0, w, h);

      for (const s of stars) {
        ctx.globalAlpha = 0.2 + 0.6 * (0.5 + 0.5 * Math.sin(t * s.speed + s.phase));
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(s.x * w, s.y * h, s.r, 0, TAU);
        ctx.fill();
      }

      ctx.globalAlpha = 1;
      const halo = ctx.createRadialGradient(cx, cy, R * 0.15, cx, cy, R * 2.3);
      halo.addColorStop(0, 'rgba(120, 128, 240, 0.38)');
      halo.addColorStop(0.45, 'rgba(90, 96, 210, 0.12)');
      halo.addColorStop(1, 'rgba(90, 96, 210, 0)');
      ctx.fillStyle = halo;
      ctx.beginPath();
      ctx.arc(cx, cy, R * 2.3, 0, TAU);
      ctx.fill();

      ring(Math.PI, TAU, 0.22);
      ctx.globalCompositeOperation = 'lighter';
      moon(false);

      const cos = Math.cos(rot);
      const sin = Math.sin(rot);
      const ct = Math.cos(tilt);
      const st = Math.sin(tilt);
      for (const [x, y, z] of points) {
        const x1 = x * cos - z * sin;
        const z1 = x * sin + z * cos;
        const y1 = y * ct - z1 * st;
        const depth = (y * st + z1 * ct + 1) / 2;
        stamp(cx + x1 * R, cy + y1 * R, 3 + depth * 7, 0.06 + depth * 0.8);
      }

      for (const d of dust) {
        const near = (Math.sin(d.a) + 1) / 2;
        stamp(cx + Math.cos(d.a) * d.r * R, cy + d.y * R + Math.sin(d.a) * R * 0.15, d.s * 6, 0.12 + 0.4 * near);
      }

      ctx.globalCompositeOperation = 'source-over';
      ring(0, Math.PI, 0.6);
      ctx.globalCompositeOperation = 'lighter';
      moon(true);
      ctx.globalCompositeOperation = 'source-over';
      ctx.globalAlpha = 1;
    };

    let raf = 0;
    let last = 0;
    let running = false;
    const loop = (now: number) => {
      const dt = Math.min((now - (last || now)) / 1000, 0.05);
      last = now;
      t += dt;
      tilt += (tiltTo - tilt) * Math.min(dt * 3, 1);
      spin += (spinTo - spin) * Math.min(dt * 2, 1);
      rot += spin * dt;
      dust.forEach((d) => (d.a += d.v * dt));
      draw();
      raf = requestAnimationFrame(loop);
    };

    size();
    draw();
    new ResizeObserver(() => {
      size();
      draw();
    }).observe(cosmos);

    if (!reduced && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting && !running) {
          running = true;
          last = 0;
          raf = requestAnimationFrame(loop);
        } else if (!entry.isIntersecting && running) {
          running = false;
          cancelAnimationFrame(raf);
        }
      }).observe(cosmos);

      // The sphere leans toward the pointer and turns a little faster.
      if (window.matchMedia('(pointer: fine)').matches) {
        cosmos.addEventListener('pointermove', (e) => {
          const r = cosmos.getBoundingClientRect();
          tiltTo = 0.35 + ((e.clientY - r.top) / r.height - 0.5) * 0.5;
          spinTo = 0.18 + ((e.clientX - r.left) / r.width - 0.5) * 0.5;
        });
        cosmos.addEventListener('pointerleave', () => {
          tiltTo = 0.35;
          spinTo = 0.18;
        });
      }
    }
  }
</script>

