---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BlurTitle from '../components/BlurTitle.astro';
import { site, waLink } from '../data/site';
import { categories, programs, programsIn, programBySlug, type CategoryId } from '../data/programs';
import { founder, awards } from '../data/people';
import { img } from '../lib/images';

const catIds = Object.keys(categories) as CategoryId[];
const ecc = programBySlug('evolving-cosmic-communion')!;
const bookText = 'Hello, I would like to book a consultation with Dr. Deepa.';

// Figures, all taken from the site data.
const stats = [
  { n: programs.length, label: 'Programs', icon: 'layers' },
  { n: catIds.length, label: 'Themes', icon: 'sparkle' },
  { n: awards.length, label: 'Awards & honours', icon: 'award' },
] as const;

// Dr. Deepa's path to this work, condensed from her story in src/data/people.ts.
const journey = [
  { title: 'Teacher & counsellor', text: 'Almost two decades teaching English.' },
  { title: 'A turning point', text: 'Recovered with Reiki after five surgeries.' },
  { title: 'Heal Your Life® leader', text: 'Certified to lead Louise L. Hay’s workshop.' },
  { title: 'Founder & channeler', text: 'Founded the centre with her daughter, Rekha Datta.' },
];
const topAward = awards[0];

const offers = [
  { image: 'gallery/session-03', tag: 'Counselling', title: 'One-to-one counselling', text: 'Sit down with Dr. Deepa, talk through what you’re facing and find your starting point.' },
  { image: 'stock/candle-hands', tag: 'Energy healing', title: 'Channelled energy work', text: 'Modalities channelled by Dr. Deepa, including Evolving Cosmic Communion.' },
  { image: 'stock/herbs', tag: 'Natural healing', title: 'Body & natural healing', text: categories.body.blurb },
];

const themeImages: Record<CategoryId, string> = {
  signature: 'stock/milky-way',
  body: 'stock/herbs',
  self: 'gallery/session-01',
  soul: 'stock/light-rays',
};

const marquee = ['Counselling', 'Energy healing', 'Workshops', 'Crystals', 'Transform Life'];

// Hero headline; the middle word is set in the softer grey.
const heroWords = [{ t: 'Find' }, { t: 'your', soft: true }, { t: 'calm' }];

// Hero tiles: every program as a small cover, in two strips that drift past
// behind the phone. Several programs share a photo, so some get a stock image.
const tileArt: Partial<Record<string, string>> = {
  'evolving-cosmic-communion': 'stock/milky-way',
  'natural-healing-secrets': 'stock/herbs',
  'holistic-to-soulistic': 'stock/nature',
  'angelic-consciousness': 'stock/candle-hands',
  merkaba: 'stock/light-rays',
};
const tiles = programs.map((p) => ({ label: p.name, image: tileArt[p.slug] ?? p.image }));
// Each strip holds every program, the second starting halfway through. The set
// is repeated three times so the loop stays seamless on very wide screens.
const tileRows = [0, 7].map((start) => tiles.map((_, k) => tiles[(start + k) % tiles.length]));
const tileLoop = [0, 1, 2];

// The phone shows how booking works: a short chat on WhatsApp that plays out
// message by message and ends with the confirmed appointment.
const hours = site.hours[0];
const chat = [
  { me: true, text: 'Hello, I would like to book a consultation with Dr. Deepa.', time: '10:24' },
  { me: false, text: `Namaste! We see clients ${hours.days}, ${hours.time}. Which day suits you?`, time: '10:26' },
  { me: true, text: 'Thursday morning, please.', time: '10:27' },
];
const booking = { when: 'Thursday · 11:00 am', where: `Dr. Deepa · ${site.address.locality}`, time: '10:28' };
---

<Base title={site.name}>
  <!-- ============ HERO: headline, chat phone between program tiles, call to action ============ -->
  <section class="hero" id="top" data-hero>
    <div class="wrap">
      <h1 class="hero-title">
        {
          heroWords.map((w, i) => (
            <>
              <span class:list={['ht', { soft: w.soft }]} style={`--li:${i}`}>{w.t}</span>{' '}
            </>
          ))
        }
      </h1>
    </div>

    <div class="hero-stage" aria-hidden="true" data-hero-stage>
      <div class="tiles">
        {
          tileRows.map((row) => (
            <div class="tile-row">
              <div class="tile-track">
                {tileLoop.map(() =>
                  row.map((t) => (
                    <div class="tile">
                      <Image src={img(t.image)} alt="" widths={[140, 260]} sizes="128px" />
                      <span>{t.label}</span>
                    </div>
                  )),
                )}
              </div>
            </div>
          ))
        }
      </div>

      <div class="phone-tilt" data-tilt>
        <div class="phone">
          <div class="screen">
            <div class="status">
              <span>10:30</span>
              <span class="island-cut"></span>
              <span class="signal"><i></i><i></i><i></i></span>
            </div>
            <div class="chat-head">
              <Icon name="chevron" size={14} class="back" />
              <span class="avatar">TL</span>
              <span class="who"><strong>Transform Life</strong><small data-chat-status>Appointments · online</small></span>
              <Icon name="phone" size={14} />
            </div>
            <div class="chat" data-chat>
              {
                chat.map((m) => (
                  <p class:list={['msg', m.me ? 'msg-out' : 'msg-in']} data-msg>
                    {m.text}
                    <small>
                      {m.time}
                      {m.me && <Icon name="check" size={10} />}
                    </small>
                  </p>
                ))
              }
              <div class="msg msg-in booked" data-msg>
                <span class="booked-head"><Icon name="check" size={12} /> Appointment confirmed</span>
                <strong>{booking.when}</strong>
                <span>{booking.where}</span>
                <small>{booking.time}</small>
              </div>
              <p class="msg msg-in typing" data-typing><i></i><i></i><i></i></p>
            </div>
            <div class="composer">
              <span>Message</span>
              <span class="send"><Icon name="arrow" size={12} /></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="wrap hero-copy">
      <p class="hero-lede">
        <strong>{site.name}</strong> is a healing and counselling centre in Bengaluru, led by {site.founder}. Counselling, energy healing and {programs.length} programs, at a pace that feels right for you.
      </p>
      <a href={waLink(site.whatsapp.appointments, bookText)} class="btn btn-ink hero-btn" target="_blank" rel="noopener"><Icon name="whatsapp" /> Book on WhatsApp</a>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="sec about" id="about">
    <div class="wrap center-head">
      <p class="eyebrow" data-animate>About us</p>
      <BlurTitle text="Meet Dr. Deepa, *a guide back to yourself.*" />
      <p class="lede" data-animate>A counsellor and energy healer who taught English for almost two decades before healing became her life’s work.</p>
    </div>

    <div class="wrap">
      <div class="card founder" data-animate="scale">
        <div class="founder-media">
          <figure class="founder-photo">
            <Image src={img('founder/portrait-lilac')} alt={founder.name} widths={[480, 720, 900]} sizes="(min-width: 860px) 40vw, 90vw" />
          </figure>
          <p class="badge badge-tag float"><Icon name="sparkle" size={14} /> Reiki Master</p>
          <p class="badge badge-award float-slow">
            <span class="badge-ic"><Icon name="award" size={18} /></span>
            <span>
              <strong>{topAward.title}</strong>
              <small>{[topAward.issuer, topAward.year].filter(Boolean).join(' · ')}</small>
            </span>
          </p>
        </div>

        <div class="founder-story">
          <div class="founder-name">
            <h3 class="card-title">{founder.name}</h3>
            <p>{founder.credentials} · Honorary Doctorate (Holistic Healing)</p>
          </div>
          <ul role="list" class="chips">
            {founder.roles.map((r) => <li>{r}</li>)}
          </ul>
          <ol role="list" class="journey">
            {
              journey.map((j) => (
                <li>
                  <strong>{j.title}</strong>
                  <span>{j.text}</span>
                </li>
              ))
            }
          </ol>
          <div class="founder-cta">
            <a href={waLink(site.whatsapp.appointments, bookText)} class="btn btn-ink" target="_blank" rel="noopener">Book a consultation <Icon name="arrow-up-right" size={14} /></a>
            <a href={`tel:${site.phones.appointments.tel}`} class="founder-call">or call {site.phones.appointments.display}</a>
          </div>
        </div>

        <dl class="founder-stats">
          {
            stats.map((s) => (
              <div>
                <dt>
                  <span class="stat-ic" aria-hidden="true"><Icon name={s.icon} size={16} /></span>
                  {s.label}
                </dt>
                <dd data-count-to={s.n}>{s.n}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ APPROACH ============ -->
  <section class="sec approach" id="approach">
    <div class="wrap center-head">
      <p class="eyebrow" data-animate>Our approach</p>
      <BlurTitle text="Heal your body, mind *and spirit in one place.*" />
      <p class="lede" data-animate>Counselling, energy healing and practical tools come together at our centre in Bengaluru. Start with a consultation and Dr. Deepa will help you choose the right path.</p>
    </div>
    <div class="wrap offer-grid" data-stagger>
      {
        offers.map((o) => (
          <article class="card offer">
            <div class="offer-img">
              <Image src={img(o.image)} alt="" widths={[480, 800]} sizes="(min-width: 860px) 30vw, 90vw" />
              <span class="offer-tag">{o.tag}</span>
            </div>
            <h3 class="card-title">{o.title}</h3>
            <p>{o.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============ SIGNATURE: Evolving Cosmic Communion with a particle sphere ============ -->
  <section class="sec signature" id="signature">
    <div class="wrap center-head">
      <p class="eyebrow" data-animate>Signature modality</p>
      <BlurTitle text="Evolving Cosmic *Communion*" />
    </div>
    <div class="wrap sphere-stage">
      <canvas class="sphere" data-sphere aria-hidden="true"></canvas>
      {
        ecc.explore.slice(0, 2).map((e, i) => (
          <div class={`card side-card side-${i}`} data-animate={i === 0 ? 'left' : 'right'}>
            <span class="side-ic"><Icon name={i === 0 ? 'sparkle' : 'layers'} size={15} /></span>
            <h3 class="card-title">{e.title}</h3>
            <p>{e.text}</p>
          </div>
        ))
      }
    </div>
    <div class="wrap center-head sig-foot">
      <p class="lede" data-animate>{ecc.short}</p>
      {ecc.quote && <blockquote class="sig-quote" data-animate>“{ecc.quote}”</blockquote>}
      <div data-animate>
        <a href={waLink(site.whatsapp.appointments, `Hello, I would like to know more about ${ecc.name}.`)} class="btn btn-ink" target="_blank" rel="noopener">Ask about ECC <Icon name="arrow-up-right" size={14} /></a>
      </div>
    </div>
  </section>

  <!-- ============ PROGRAMS ============ -->
  <section class="sec programs" id="programs">
    <div class="wrap center-head">
      <p class="eyebrow" data-animate>Programs</p>
      <BlurTitle text="Programs that *meet you where you are.*" />
      <p class="lede" data-animate>{programs.length} programs across four themes. Not sure where to start? Ask us — we’ll help you choose.</p>
    </div>

    <div class="wrap" data-tabs>
      <div class="tab-row" role="tablist" aria-label="Program themes" data-animate>
        {
          catIds.map((id, i) => (
            <button class={`tab-btn ${categories[id].tone}`} role="tab" id={`tab-${id}`} aria-controls={`theme-${id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab>
              <span class="tab-dot" aria-hidden="true"></span>
              {categories[id].name}
              <span class="tab-count">{programsIn(id).length}</span>
            </button>
          ))
        }
      </div>

      {
        catIds.map((id, i) => {
          const list = programsIn(id);
          return (
            <div class={`card panel ${categories[id].tone}`} role="tabpanel" id={`theme-${id}`} aria-labelledby={`tab-${id}`} data-panel data-active={i === 0 ? '' : undefined}>
              <div class="panel-feature">
                <div class="panel-img">
                  <Image src={img(themeImages[id])} alt="" widths={[560, 900]} sizes="(min-width: 960px) 40vw, 92vw" />
                </div>
                <div class="panel-info">
                  <span class="ct">{list.length} programs</span>
                  <h3 class="card-title">{categories[id].name}</h3>
                  <p>{categories[id].blurb}</p>
                </div>
              </div>
              <ol role="list" class="prog-list">
                {list.map((p, n) => (
                  <li>
                    <a href={waLink(site.whatsapp.appointments, `Hello, I would like to know more about ${p.name}.`)} class="prog-row" target="_blank" rel="noopener">
                      <span class="prog-n">{String(n + 1).padStart(2, '0')}</span>
                      <span class="prog-txt">
                        <strong>{p.name}</strong>
                        <span>{p.short}</span>
                      </span>
                      <span class="prog-go" aria-hidden="true"><Icon name="arrow-up-right" size={15} /></span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- ============ WORDMARK BAND ============ -->
  <div class="sec centre" aria-hidden="true">
    <div class="marquee">
      <div class="marquee-track">
        {[0, 1].map(() => <span class="marquee-set">{marquee.map((m) => <span>{m} <i>—</i> </span>)}</span>)}
      </div>
    </div>
  </div>
</Base>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Program theme tabs (arrow keys move between them).
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(j === i));
        t.tabIndex = j === i ? 0 : -1;
      });
      panels.forEach((p, j) => p.toggleAttribute('data-active', j === i));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        select((i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length, true);
      });
    });
    const fromHash = panels.findIndex((p) => `#${p.id}` === window.location.hash);
    if (fromHash >= 0) select(fromHash);
  });

  // Hero: the tile strips pause while off screen, the phone leans toward the
  // pointer, and the chat plays out on a loop. With reduced motion the whole
  // conversation simply shows, still.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  if (stage && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => stage.classList.toggle('paused', !entry.isIntersecting)).observe(stage);
  }

  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  if (!reduced && hero && tilt && window.matchMedia('(pointer: fine)').matches) {
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      const nx = (e.clientX - r.left) / r.width - 0.5;
      const ny = (e.clientY - r.top) / r.height - 0.5;
      tilt.style.setProperty('--ry', `${(nx * 10).toFixed(2)}deg`);
      tilt.style.setProperty('--rx', `${(-ny * 6).toFixed(2)}deg`);
    });
    hero.addEventListener('pointerleave', () => {
      tilt.style.removeProperty('--rx');
      tilt.style.removeProperty('--ry');
    });
  }

  const chatBox = document.querySelector<HTMLElement>('[data-chat]');
  if (!reduced && chatBox) {
    const items = Array.from(chatBox.querySelectorAll<HTMLElement>('[data-msg]'));
    const typing = chatBox.querySelector<HTMLElement>('[data-typing]');
    const status = document.querySelector<HTMLElement>('[data-chat-status]');
    const online = status?.textContent ?? '';
    const wait = (ms: number) => new Promise((done) => setTimeout(done, ms));
    const setTyping = (on: boolean) => {
      typing?.classList.toggle('on', on);
      if (status) status.textContent = on ? 'typing…' : online;
    };

    chatBox.classList.add('is-live');
    (async () => {
      for (let first = true; ; first = false) {
        chatBox.classList.remove('fading');
        items.forEach((el) => el.classList.remove('shown'));
        await wait(first ? 1500 : 700);
        for (const el of items) {
          // Replies from the centre are preceded by a moment of typing.
          if (!el.classList.contains('msg-out')) {
            setTyping(true);
            await wait(1500);
            setTyping(false);
          }
          el.classList.add('shown');
          await wait(1300);
        }
        await wait(4500);
        chatBox.classList.add('fading');
        await wait(500);
      }
    })();
  }

  // A slowly turning sphere of points with an orbit and drifting dust,
  // drawn only while it is on screen.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-sphere]');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const points: [number, number, number][] = [];
    const count = 760;
    for (let i = 0; i < count; i++) {
      const y = 1 - (i / (count - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      const t = i * 2.399963;
      points.push([Math.cos(t) * r, y, Math.sin(t) * r]);
    }
    const dust = Array.from({ length: 150 }, () => ({
      a: Math.random() * Math.PI * 2,
      r: 1.2 + Math.random() * 1.1,
      y: (Math.random() - 0.5) * 1.5,
      s: Math.random() * 0.7 + 0.3,
      v: Math.random() * 0.002 + 0.0008,
    }));
    let w = 0;
    let h = 0;
    let rot = 0;
    let raf = 0;
    let running = false;

    const size = () => {
      const box = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = box.width;
      h = box.height;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      const R = Math.min(w, h) * 0.3;
      const cx = w / 2;
      const cy = h / 2;
      const glow = ctx.createRadialGradient(cx, cy, R * 0.1, cx, cy, R * 1.7);
      glow.addColorStop(0, 'rgba(180, 186, 234, 0.45)');
      glow.addColorStop(1, 'rgba(180, 186, 234, 0)');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(cx, cy, R * 1.7, 0, Math.PI * 2);
      ctx.fill();

      const cos = Math.cos(rot);
      const sin = Math.sin(rot);
      const ct = Math.cos(0.35);
      const st = Math.sin(0.35);
      for (const [x, y, z] of points) {
        const x1 = x * cos - z * sin;
        const z1 = x * sin + z * cos;
        const y1 = y * ct - z1 * st;
        const depth = (y * st + z1 * ct + 1) / 2;
        const s = 0.6 + depth * 1.7;
        ctx.fillStyle = `rgba(63, 70, 184, ${0.1 + 0.75 * depth})`;
        ctx.fillRect(cx + x1 * R - s / 2, cy + y1 * R - s / 2, s, s);
      }

      ctx.strokeStyle = 'rgba(63, 70, 184, 0.22)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.ellipse(cx, cy, R * 1.5, R * 0.4, -0.25, 0, Math.PI * 2);
      ctx.stroke();

      for (const d of dust) {
        const x = Math.cos(d.a) * d.r * R;
        const near = (Math.sin(d.a) + 1) / 2;
        ctx.fillStyle = `rgba(106, 113, 214, ${0.2 + 0.5 * near})`;
        ctx.beginPath();
        ctx.arc(cx + x, cy + d.y * R + Math.sin(d.a) * R * 0.15, d.s * 1.3, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const loop = () => {
      rot += 0.0035;
      dust.forEach((d) => (d.a += d.v));
      draw();
      raf = requestAnimationFrame(loop);
    };

    size();
    draw();
    window.addEventListener('resize', () => {
      size();
      draw();
    });

    if (!reduced && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting && !running) {
          running = true;
          loop();
        } else if (!entry.isIntersecting && running) {
          running = false;
          cancelAnimationFrame(raf);
        }
      }).observe(canvas);
    }
  }
</script>

<style>
  /* ---------- Page shell ---------- */
  .wrap {
    width: min(100% - 2 * var(--gutter), 1200px);
    margin-inline: auto;
  }

  .sec {
    position: relative;
    padding-block: clamp(4.5rem, 9vw, 8rem);
    color: var(--text-2);
  }

  .center-head {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    max-width: 820px;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .eyebrow {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--card-line);
    border-radius: 999px;
    background: var(--white);
    box-shadow: var(--card-shadow);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .center-head :global(.blur-title) {
    font-size: clamp(2.1rem, 1.3rem + 3vw, 3.75rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.045em;
    color: var(--ink);
    text-wrap: balance;
  }

  /* Two-tone headlines: the highlighted words go grey, as in the hero */
  .center-head :global(.blur-title em) {
    color: var(--soft-ink);
  }

  .lede {
    max-width: 54ch;
    font-size: clamp(0.9375rem, 0.88rem + 0.2vw, 1.0625rem);
    color: var(--text-3);
  }

  .card {
    border: 1px solid var(--card-line);
    border-radius: 24px;
    background: var(--white);
    box-shadow: var(--card-shadow);
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--ink);
  }

  /* ---------- Hero ---------- */
  .hero {
    padding-top: calc(var(--header-h) + clamp(2rem, 4.5vw, 3.75rem));
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
    text-align: center;
  }

  .hero-title {
    font-size: clamp(2.4rem, 1rem + 5vw, 4.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .ht {
    display: inline-block;
  }

  .ht.soft {
    color: var(--soft-ink);
  }

  .hero-stage {
    --pw: clamp(210px, 22vw, 290px); /* phone width */
    --ts: clamp(64px, 8.6vw, 128px); /* tile size */
    position: relative;
    height: calc(var(--pw) * 1.6);
    margin-top: clamp(1.75rem, 3vw, 2.75rem);
    overflow: hidden;
  }

  /* The foot of the phone and the lower tiles melt into the page */
  .hero-stage::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    height: 26%;
    background: linear-gradient(180deg, transparent, var(--paper) 90%);
    pointer-events: none;
  }

  /* Two strips of program covers drifting in opposite directions, passing
     behind the phone and fading out at the screen edges */
  .tiles {
    position: absolute;
    inset: calc(var(--pw) * 0.22) 0 auto;
    display: grid;
    gap: 8px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
  }

  .tile-track {
    display: flex;
    gap: 8px;
    width: max-content;
  }

  .tile {
    position: relative;
    flex: none;
    width: var(--ts);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    background: var(--stone-200);
    box-shadow: 0 10px 22px -16px rgba(24, 24, 29, 0.5);
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(12, 12, 20, 0.6), rgba(12, 12, 20, 0) 60%);
  }

  .tile span {
    position: absolute;
    inset: 8% 8% auto;
    z-index: 1;
    font-family: var(--font-display);
    font-size: calc(var(--ts) * 0.095);
    font-weight: 700;
    line-height: 1.05;
    text-align: left;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--white);
  }

  /* The wrapper carries the pointer tilt; the phone inside carries its own
     entrance, so the two transforms never fight. */
  .phone-tilt {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 2;
    width: var(--pw);
    translate: -50% 0;
    transform: perspective(1400px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.9s var(--ease);
  }

  .phone {
    position: relative;
    aspect-ratio: 9 / 18.6;
    padding: calc(var(--pw) * 0.032);
    border-radius: calc(var(--pw) * 0.17);
    background: #0c0c0e;
    container-type: inline-size;
    box-shadow:
      inset 0 0 0 1px #2c2c31,
      0 0 0 calc(var(--pw) * 0.01) #cfcfd4,
      0 30px 60px -24px rgba(24, 24, 29, 0.5),
      0 0 70px 40px rgba(244, 244, 242, 0.85); /* haze that softens the nearest tiles */
  }

  /* Side buttons: volume on the left, power on the right */
  .phone::before,
  .phone::after {
    content: '';
    position: absolute;
    width: 3px;
    border-radius: 2px;
    background: #b9b9c0;
  }

  .phone::before {
    top: 19%;
    left: -4px;
    height: 6%;
    box-shadow: 0 calc(var(--pw) * 0.16) 0 #b9b9c0;
  }

  .phone::after {
    top: 25%;
    right: -4px;
    height: 10%;
  }

  /* A faint sheen across the glass */
  .screen::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0) 32%);
    pointer-events: none;
  }

  .screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--pw) * 0.14);
    background: #0f1115;
    color: #e9e9ee;
    font-family: var(--font-display);
    font-size: 4.3cqi;
    line-height: 1.35;
    text-align: left;
  }

  .status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1em 1.7em 0.5em;
    font-size: 0.95em;
    font-weight: 600;
  }

  .island-cut {
    position: absolute;
    top: 0.7em;
    left: 50%;
    width: 32%;
    height: 1.9em;
    border-radius: 999px;
    background: #000;
    translate: -50% 0;
  }

  .signal {
    display: flex;
    align-items: flex-end;
    gap: 0.2em;
    height: 0.9em;
  }

  .signal i {
    width: 0.28em;
    border-radius: 1px;
    background: currentColor;
  }

  .signal i:nth-child(1) {
    height: 45%;
  }

  .signal i:nth-child(2) {
    height: 70%;
  }

  .signal i:nth-child(3) {
    height: 100%;
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.6em 1em 0.7em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: #16181d;
  }

  .chat-head :global(svg) {
    flex: none;
    width: 1.3em;
    height: 1.3em;
    color: #b9bdd0;
  }

  .chat-head :global(.back) {
    rotate: 90deg;
  }

  .avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5em;
    height: 2.5em;
    border-radius: 50%;
    background: var(--periwinkle);
    color: var(--night);
    font-size: 0.85em;
    font-weight: 700;
  }

  .who {
    display: grid;
    flex: 1;
    line-height: 1.25;
  }

  .who strong {
    font-weight: 600;
  }

  .who small {
    font-size: 0.78em;
    color: #8e93a6;
  }

  .chat {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.55em;
    padding: 0.9em;
  }

  .msg {
    max-width: 84%;
    padding: 0.55em 0.8em 0.4em;
    border-radius: 1.1em;
  }

  .msg small {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.2em;
    margin-top: 0.15em;
    font-size: 0.72em;
    color: rgba(255, 255, 255, 0.55);
  }

  .msg small :global(svg) {
    width: 1.2em;
    height: 1.2em;
  }

  .msg-in {
    align-self: flex-start;
    border-bottom-left-radius: 0.3em;
    background: #1f2229;
  }

  .msg-out {
    align-self: flex-end;
    border-bottom-right-radius: 0.3em;
    background: var(--blue);
  }

  /* The centre's reply: a confirmed-appointment card */
  .booked {
    display: grid;
    gap: 0.15em;
    min-width: 72%;
    padding: 0.7em 0.85em 0.4em;
    border: 1px solid rgba(180, 186, 234, 0.22);
    background: linear-gradient(160deg, #262a55, #1f2229 70%);
  }

  .booked-head {
    display: flex;
    align-items: center;
    gap: 0.35em;
    margin-bottom: 0.2em;
    font-size: 0.72em;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--periwinkle-200);
  }

  .booked-head :global(svg) {
    width: 1.3em;
    height: 1.3em;
  }

  .booked strong {
    font-size: 1.15em;
    font-weight: 600;
  }

  .booked > span:not(.booked-head) {
    font-size: 0.85em;
    color: #b9bdd0;
  }

  /* Typing dots, shown only while the conversation plays */
  .typing {
    display: none;
    gap: 0.3em;
    padding: 0.8em 0.9em;
  }

  .typing i {
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: #8e93a6;
    animation: typing 1.2s ease-in-out infinite;
  }

  .typing i:nth-child(2) {
    animation-delay: 0.15s;
  }

  .typing i:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes typing {
    0%,
    60%,
    100% {
      opacity: 0.35;
      transform: none;
    }

    30% {
      opacity: 1;
      transform: translateY(-0.25em);
    }
  }

  .chat {
    transition: opacity 0.45s;
  }

  .chat.fading {
    opacity: 0;
  }

  .chat.is-live [data-msg]:not(.shown) {
    display: none;
  }

  .chat.is-live .typing.on {
    display: flex;
  }

  .chat.is-live .shown {
    animation: msg-in 0.5s var(--ease-out) both;
  }

  .msg-out.shown {
    transform-origin: bottom right;
  }

  .msg-in.shown {
    transform-origin: bottom left;
  }

  .composer {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.6em 0.8em 1.4em;
  }

  .composer span:first-child {
    flex: 1;
    padding: 0.6em 1em;
    border-radius: 999px;
    background: #1d2027;
    color: #7d8296;
  }

  .send {
    display: grid;
    place-items: center;
    width: 2.4em;
    height: 2.4em;
    border-radius: 50%;
    background: var(--blue);
  }

  .hero-copy {
    position: relative;
    z-index: 4;
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .hero-lede {
    max-width: 62ch;
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.125rem);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: balance;
  }

  .hero-lede strong {
    font-weight: 600;
    color: var(--blue);
  }

  .hero-btn {
    min-height: 56px;
    padding: 0.9rem 1.6rem;
    border-radius: 14px;
    font-size: 1rem;
    box-shadow: 0 20px 34px -14px rgba(18, 18, 20, 0.6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ht {
      animation: rise 1s var(--ease-out) backwards;
      animation-delay: calc(var(--li) * 110ms + 150ms);
    }

    .phone {
      animation: phone-in 1.4s var(--ease-out) 0.2s backwards;
    }

    .tiles {
      animation: tiles-in 1.4s var(--ease-out) 0.5s backwards;
    }

    .tile-track {
      animation: tiles-drift 90s linear infinite;
    }

    .tile-row + .tile-row .tile-track {
      animation-duration: 110s;
      animation-direction: reverse;
    }

    .hero-stage.paused .tile-track {
      animation-play-state: paused;
    }

    .hero-copy > * {
      animation: fade-up 0.9s var(--ease-out) 0.8s backwards;
    }

    .hero-copy > * + * {
      animation-delay: 0.95s;
    }
  }

  /* Headline words sharpen in from a blur, like the section headings */
  @keyframes rise {
    from {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(0.3em);
    }
  }

  /* The phone tips up out of the page and settles */
  @keyframes phone-in {
    from {
      opacity: 0;
      transform: perspective(1400px) translateY(80px) rotateX(24deg) scale(0.94);
    }

    to {
      opacity: 1;
      transform: perspective(1400px) translateY(0) rotateX(0deg) scale(1);
    }
  }

  @keyframes tiles-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  /* One full set of covers (a third of the track, plus its gap) per loop */
  @keyframes tiles-drift {
    to {
      transform: translateX(calc((-100% - 8px) / 3));
    }
  }

  @keyframes msg-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.92);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  /* ---------- About ---------- */
  .about {
    isolation: isolate;
  }

  /* A soft periwinkle glow behind the founder card */
  .about::before {
    content: '';
    position: absolute;
    top: 40%;
    left: 50%;
    z-index: -1;
    width: min(1100px, 100%);
    height: 55%;
    translate: -50% 0;
    background: radial-gradient(45% 55% at 28% 50%, rgba(180, 186, 234, 0.5), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }

  .founder {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    padding: clamp(0.6rem, 1.2vw, 0.75rem);
    border-radius: 26px;
  }

  @media (min-width: 860px) {
    .founder {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    }

    .founder-stats {
      grid-column: 1 / -1;
    }
  }

  .founder-media {
    position: relative;
  }

  /* The image is positioned absolutely so its own height never stretches
     the row; on wide screens the photo matches the story's height. */
  .founder-photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    background: var(--periwinkle-100);
  }

  @media (min-width: 860px) {
    .founder-photo {
      aspect-ratio: auto;
      height: 100%;
      min-height: 400px;
    }
  }

  .founder-photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
  }

  /* Floating glass badges on the photo */
  .badge {
    position: absolute;
    display: flex;
    align-items: center;
    border: 1px solid var(--card-line);
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 16px 34px -18px rgba(24, 24, 29, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--ink);
  }

  .badge-tag {
    top: 1rem;
    right: 1rem;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .badge-tag :global(svg) {
    color: var(--blue);
  }

  .badge-award {
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    gap: 0.75rem;
    max-width: 320px;
    padding: 0.75rem 1rem 0.75rem 0.75rem;
    border-radius: 18px;
  }

  /* On wide screens the award card hangs a little past the photo's edge */
  @media (min-width: 860px) {
    .badge-award {
      right: calc(-1 * clamp(1rem, 2vw, 1.75rem));
      bottom: 2rem;
      left: auto;
    }
  }

  .badge-ic {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--periwinkle-50);
    color: var(--blue);
  }

  .badge-award strong {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .badge-award small {
    display: block;
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .founder-story {
    display: grid;
    align-content: center;
    gap: 1rem;
    padding: clamp(0.5rem, 1.5vw, 1.25rem);
  }

  .founder-name {
    display: grid;
    gap: 0.25rem;
  }

  .founder-name .card-title {
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.125rem);
  }

  .founder-name p {
    font-size: 0.8125rem;
    color: var(--text-3);
  }

  .founder .chips li {
    padding: 0.2rem 0.65rem;
    font-size: 0.75rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chips li {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--card-line);
    border-radius: 999px;
    background: var(--paper);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-2);
  }

  /* Her path as a short timeline: dots joined by a thin line, the latest
     step filled in */
  .journey {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }

  .journey li {
    position: relative;
    display: grid;
    padding-left: 1.75rem;
    line-height: 1.45;
  }

  .journey li::before {
    content: '';
    position: absolute;
    top: 4px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: inset 0 0 0 3px var(--periwinkle-500);
  }

  .journey li:last-child::before {
    background: var(--blue);
    box-shadow: 0 0 0 4px var(--periwinkle-100);
  }

  .journey li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 20px;
    bottom: calc(-0.75rem - 1px);
    left: 5.5px;
    width: 1px;
    background: var(--periwinkle-200);
  }

  .journey strong {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
  }

  .journey span {
    font-size: 0.8125rem;
    color: var(--text-3);
  }

  .founder-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .founder-cta .btn {
    min-height: 46px;
    padding: 0.7rem 1.25rem;
    font-size: 0.875rem;
  }

  .founder-call {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: color 0.2s, background-size 0.4s var(--ease);
  }

  .founder-call:hover {
    color: var(--ink);
    background-size: 100% 1px;
  }

  /* Figures as tiles; the last one is set in ink for contrast */
  .founder-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .founder-stats div {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
    padding: clamp(0.8rem, 1.5vw, 1.05rem) clamp(0.9rem, 1.5vw, 1.25rem);
    border-radius: 16px;
    background: var(--paper);
  }

  .founder-stats dt {
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .founder-stats dd {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.3rem + 0.9vw, 2.125rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .stat-ic {
    position: absolute;
    top: 50%;
    right: clamp(0.9rem, 1.5vw, 1.25rem);
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    translate: 0 -50%;
    border-radius: 50%;
    background: var(--white);
    box-shadow: var(--card-shadow);
    color: var(--blue);
  }

  @media (max-width: 559px) {
    .stat-ic {
      display: none;
    }
  }

  .founder-stats div:last-child {
    background: #121214;
  }

  .founder-stats div:last-child dt {
    color: rgba(255, 255, 255, 0.6);
  }

  .founder-stats div:last-child dd {
    color: var(--white);
  }

  .founder-stats div:last-child .stat-ic {
    background: rgba(255, 255, 255, 0.1);
    box-shadow: none;
    color: var(--periwinkle-200);
  }

  /* ---------- Approach ---------- */
  .offer-grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  @media (min-width: 860px) {
    .offer-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .offer {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 0.6rem 0.6rem 1.5rem;
  }

  .offer-img {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    margin-bottom: 0.6rem;
    border-radius: 18px;
  }

  .offer-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .offer:hover .offer-img :global(img) {
    transform: scale(1.04);
  }

  .offer-tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink);
  }

  .offer h3,
  .offer p {
    padding-inline: 0.9rem;
  }

  .offer h3 {
    font-size: 1.375rem;
  }

  .offer p {
    font-size: 0.9375rem;
    color: var(--text-3);
  }

  /* ---------- Signature ---------- */
  .sphere-stage {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .sphere {
    width: min(100%, 520px);
    height: auto;
    aspect-ratio: 1;
  }

  @media (min-width: 960px) {
    .sphere-stage {
      grid-template-columns: 1fr minmax(0, 520px) 1fr;
      align-items: center;
    }

    .sphere {
      grid-column: 2;
      grid-row: 1;
    }

    .side-0 {
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
    }

    .side-1 {
      grid-column: 3;
      grid-row: 1;
      justify-self: start;
    }
  }

  .side-card {
    display: grid;
    gap: 0.6rem;
    max-width: 340px;
    padding: 1.5rem;
  }

  .side-ic {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--periwinkle-50);
    color: var(--blue);
  }

  .side-card h3 {
